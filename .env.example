# Copiar a .env y cambiar TODOS los valores en producción

# MongoDB
MONGO_USER=miniapp
MONGO_PASSWORD=cambia-esta-contraseña

# JWT (usar cadenas largas y aleatorias, p. ej. `openssl rand -base64 48`)
JWT_SECRET=
JWT_REFRESH_SECRET=

# true si la app se sirve por HTTPS
COOKIE_SECURE=false

# Orígenes permitidos para CORS (separados por comas)
CORS_ORIGIN=http://localhost:4200

# Administrador inicial (se pedirá cambiar la contraseña en el primer acceso)
ADMIN_EMAIL=admin@miniapp.local
ADMIN_PASSWORD=cambia-esta-contraseña

# Intentos de login permitidos por minuto e IP
LOGIN_RATE_LIMIT=5
